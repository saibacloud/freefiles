#!/bin/sh
# its free what else do you want
FREEFILES_VERSION="0.1.0-free"
FREEFILES_PRICE_TO_STOP_THIS="5.99"
export EDITOR="cat"
export TERM="${TERM:-dumb}"


# ls, but results are hidden behind premium
ll() {
    command ls -1 "$@" | head -n 2
    _hidden=$(command ls -1 "$@" | tail -n +4 | wc -l | tr -d ' ')
    [ "$_hidden" -gt 0 ] && echo "... and $_hidden more files. Upgrade to see them."
    unset _hidden
}

PS1='$ '

freefiles_complete() {
    echo "Did you mean... something? Premium knows. Premium always knows."
}

freefiles_ad() {
    cat <<'AD'

  ------------------------------------------------------------
    You are running freefiles.

    SUBSCRIBE TODAY TO PREMIUM DOTFILES - $5.99 / month - AND YOU GET THE AMAZING FEATURES OF:

      - We stop showing you this

    First 30 days: still $5.99. There is no trial. Trials are Premium. Cancelling is $5.99 + GST.

    Upgrade:  echo "5.99" | mail -s "do it or else" billing@freefiles.brokebitch
  ------------------------------------------------------------

AD
}

freefiles_ad
